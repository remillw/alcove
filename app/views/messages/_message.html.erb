<% them = message.assistant? %>
<div id="<%= dom_id(message) %>" class="msg <%= them ? "msg--them" : "msg--me" %> <%= "msg--safety" if message.status == "blocked" %>">
  <% if message.active? %>
    <p class="msg__text"><span id="<%= dom_id(message, :body) %>" class="line__body" aria-busy="true"><%= message.content -%></span><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span></p>
    <span class="visually-hidden" role="status"><%= message.character.first_name %> is typing</span>
    <% if message.part_of_id.nil? %><%= button_to "Stop", cancel_message_path(message), method: :patch, class: "msg__stop", form: { data: { turbo_stream: true } } %><% end %>
  <% else %>
    <% if message.content.present? %><p class="msg__text"><%= message.content %></p><% end %>
    <% if message.failed? %>
      <p class="msg__aside"><%= message.character.first_name %> lost the thread<%= " halfway" if message.content.present? %>. Your credit was returned; send it again.</p>
    <% elsif message.cancelled? %>
      <p class="msg__aside">(stopped)</p>
    <% elsif them && message.status == "completed" %>
      <details class="msg__more">
        <summary aria-label="More options"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/></svg></summary>
        <%= button_to "Report this reply", report_message_path(message), id: dom_id(message, :report), class: "msg__report", form: { data: { turbo_confirm: "Report this reply? We'll review it." } } %>
      </details>
    <% end %>
  <% end %>
</div>
