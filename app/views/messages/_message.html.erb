<% them = message.assistant? %>
<div id="<%= dom_id(message) %>" class="msg <%= them ? "msg--them" : "msg--me" %> <%= "msg--safety" if message.status == "blocked" %>">
  <% if message.active? %>
    <p class="msg__text"><span id="<%= dom_id(message, :body) %>" class="line__body" aria-busy="true"><%= message.content -%></span><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span></p>
    <span class="visually-hidden" role="status"><%= t(".typing", name: message.character.first_name) %></span>
    <% if message.part_of_id.nil? %><%= button_to t(".stop"), cancel_message_path(message), method: :patch, class: "msg__stop", form: { data: { turbo_stream: true } } %><% end %>
  <% else %>
    <% if message.content.present? %><p class="msg__text"><%= message_html(message.content) %></p><% end %>
    <% if message.failed? %>
      <p class="msg__aside"><%= t(message.content.present? ? ".lost_halfway" : ".lost", name: message.character.first_name) %></p>
    <% elsif message.cancelled? %>
      <p class="msg__aside"><%= t(".stopped") %></p>
    <% elsif them && message.status == "completed" %>
      <details class="msg__more">
        <summary aria-label="<%= t(".more") %>"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/></svg></summary>
        <%= button_to t(".report"), report_message_path(message), id: dom_id(message, :report), class: "msg__report", form: { data: { turbo_confirm: t(".report_confirm") } } %>
      </details>
    <% end %>
  <% end %>
</div>
