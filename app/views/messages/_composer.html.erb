<% user = conversation.user %>
<div id="composer" class="composer">
  <% if error.present? && error != :no_credits %><p class="composer__error" role="alert"><%= error %></p><% end %>
  <% if user.credit_balance.zero? || error == :no_credits %>
    <div class="paywall">
      <% if user.guest? %>
        <h2><%= t("messages.composer.guest_title", name: conversation.character.first_name) %></h2>
        <p><%= t("messages.composer.guest_text", count: User::SIGNUP_CREDITS) %></p>
        <%= link_to t("messages.composer.guest_cta"), new_registration_path, class: "btn btn--primary" %>
      <% else %>
        <h2><%= t("messages.composer.member_title") %></h2>
        <p><%= t("messages.composer.member_text", count: DailyCredits::DAILY_FLOOR) %></p>
        <%= render "payments/offers", user: user %>
      <% end %>
    </div>
  <% else %>
    <%= form_with url: conversation_messages_path(conversation), class: "composer__form", data: { controller: "composer", action: "turbo:submit-end->composer#reset" } do |f| %>
      <%= hidden_field_tag :nonce, "", data: { composer_target: "nonce" } %>
      <div class="composer__box">
        <label for="content" class="visually-hidden"><%= t("messages.composer.label", name: conversation.character.first_name) %></label>
        <%= text_area_tag :content, nil, rows: 1, maxlength: Message::MAX_LENGTH, required: true, autocomplete: "off",
              placeholder: t("messages.composer.placeholder", name: conversation.character.first_name),
              data: { composer_target: "input", action: "keydown->composer#submitOnEnter" } %>
        <button type="submit" class="btn btn--primary composer__send" aria-label="<%= t("messages.composer.send") %>" data-composer-target="send">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
        </button>
      </div>
    <% end %>
  <% end %>
</div>
