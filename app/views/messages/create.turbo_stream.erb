<%= turbo_stream.append "log", partial: "messages/message", locals: { message: @message } %>
<%= turbo_stream.append "log", partial: "messages/message", locals: { message: @reply } if @reply %>
<% if current_user.credit_balance.zero? %>
  <%= turbo_stream.replace "composer", partial: "messages/composer", locals: { conversation: @conversation, error: nil } %>
<% end %>
<%= turbo_stream.update "suggestions", "" %>
