<% content_for :title, "Account" %>
<div class="stage stage--narrow stack">
  <section class="panel">
    <p class="eyebrow">Credits</p>
    <p class="balance"><%= current_user.credit_balance %></p>
    <p class="muted">One credit per reply. Topped up to <%= DailyCredits::DAILY_FLOOR %> every day for free.</p>
    <% if @entries.any? %>
      <table class="ledger">
        <thead><tr><th>Date</th><th>Movement</th><th>Credits</th></tr></thead>
        <tbody>
          <% @entries.each do |entry| %>
            <tr>
              <td><%= l entry.created_at, format: :short %></td>
              <td><%= { "grant" => "Free credits", "reserve" => "Reply", "release" => "Refund (reply failed)", "purchase" => "Purchase", "adjustment" => "Adjustment" }[entry.kind] %></td>
              <td><%= entry.amount.positive? ? "+#{entry.amount}" : entry.amount %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </section>

  <section class="panel">
    <p class="eyebrow"><%= t(".buy_credits") %></p>
    <% if (subscription = current_user.active_subscription) %>
      <p class="muted"><%= t(".subscribed", plan: t("payments.offers.products.#{subscription.product_key}.title"), date: payments_date(subscription.current_period_end)) %></p>
    <% end %>
    <%= render "payments/offers", user: current_user %>
  </section>

  <section class="panel">
    <p class="eyebrow">Account</p>
    <p><%= current_user.display_name.presence || "No name set" %> · <%= current_user.email_address %></p>
    <div class="row">
      <%= link_to "Download my data", export_account_path, class: "btn" %>
      <%= button_to "Log out", session_path, method: :delete, class: "btn btn--quiet" %>
    </div>
  </section>

  <section class="panel danger-zone">
    <p class="eyebrow">Delete account</p>
    <p class="muted">Deletes your account, every conversation and everything the characters remember. This can't be undone.</p>
    <%= button_to "Delete my account", account_path, method: :delete, class: "btn btn--danger", form: { data: { turbo_confirm: "Delete your account and all your conversations for good?" } } %>
  </section>
</div>
