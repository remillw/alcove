<% content_for :title, t("site.account") %>
<div class="stage stage--narrow stack">
  <section class="panel">
    <p class="eyebrow"><%= t(".credits") %></p>
    <p class="balance"><%= current_user.credit_balance %></p>
    <p class="muted"><%= t(".credits_text", count: DailyCredits::DAILY_FLOOR) %></p>
    <% if @entries.any? %>
      <table class="ledger">
        <thead><tr><th><%= t(".date") %></th><th><%= t(".movement") %></th><th><%= t(".credits") %></th></tr></thead>
        <tbody>
          <% @entries.each do |entry| %>
            <tr>
              <td><%= l entry.created_at, format: :short %></td>
              <td><%= t(".kinds.#{entry.kind}") %></td>
              <td><%= entry.amount.positive? ? "+#{entry.amount}" : entry.amount %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </section>

  <section class="panel">
    <p class="eyebrow"><%= t(".buy_credits") %></p>
    <% if (subscription = current_user.active_subscription) %>
      <p class="muted"><%= t(".subscribed", plan: t("payments.offers.products.#{subscription.product_key}.title"), date: payments_date(subscription.current_period_end)) %></p>
    <% end %>
    <%= render "payments/offers", user: current_user %>
  </section>

  <section class="panel">
    <p class="eyebrow"><%= t(".account") %></p>
    <p><%= current_user.display_name.presence || t(".no_name") %> · <%= current_user.email_address %></p>
    <div class="row">
      <%= link_to t(".download"), export_account_path, class: "btn" %>
      <%= button_to t(".log_out"), session_path, method: :delete, class: "btn btn--quiet" %>
    </div>
  </section>

  <section class="panel danger-zone">
    <p class="eyebrow"><%= t(".delete_title") %></p>
    <p class="muted"><%= t(".delete_text") %></p>
    <%= button_to t(".delete"), account_path, method: :delete, class: "btn btn--danger", form: { data: { turbo_confirm: t(".delete_confirm") } } %>
  </section>
</div>
