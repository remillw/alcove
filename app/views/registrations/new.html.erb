<% content_for :title, t(".title") %>
<div class="stage stage--narrow">
  <section class="panel">
    <div>
      <h1><%= t(".title") %></h1>
      <p class="panel__lead"><%= t(".lead", credits: User::SIGNUP_CREDITS, floor: DailyCredits::DAILY_FLOOR) %></p>
    </div>
    <% if @errors.present? %>
      <ul class="errors" role="alert"><% @errors.each do |e| %><li><%= e %></li><% end %></ul>
    <% end %>
    <%= form_with url: registration_path, class: "form" do |f| %>
      <div class="field">
        <%= f.label :display_name, t(".name"), class: "field__label" %>
        <%= f.text_field :display_name, class: "input", maxlength: 40, autocomplete: "nickname", value: params[:display_name] %>
        <span class="field__hint"><%= t(".name_hint") %></span>
      </div>
      <div class="field">
        <%= f.label :email_address, t(".email"), class: "field__label" %>
        <%= f.email_field :email_address, class: "input", required: true, autocomplete: "email", value: params[:email_address] %>
      </div>
      <div class="field">
        <%= f.label :password, t(".password"), class: "field__label" %>
        <%= f.password_field :password, class: "input", required: true, minlength: 10, autocomplete: "new-password" %>
        <span class="field__hint"><%= t(".password_hint") %></span>
      </div>
      <label class="check"><%= check_box_tag :adult, "1", false, required: true %><span><%= t(".adult") %></span></label>
      <label class="check"><%= check_box_tag :terms, "1", false, required: true %><span><%= t(".terms_html", terms: link_to(t(".terms_link"), terms_path, target: "_blank"), privacy: link_to(t(".privacy_link"), privacy_path, target: "_blank")) %></span></label>
      <%= f.button t(".submit"), class: "btn btn--primary" %>
    <% end %>
    <p class="muted"><%= t(".have_account") %> <%= link_to t("site.log_in"), new_session_path %></p>
  </section>
</div>
