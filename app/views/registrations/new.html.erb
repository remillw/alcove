<% content_for :title, "Create your account" %>
<div class="stage stage--narrow">
  <section class="panel">
    <div>
      <h1>Keep your characters</h1>
      <p class="panel__lead">An account keeps your conversations and what the characters remember about you. You get <%= User::SIGNUP_CREDITS %> credits, then a free top-up to <%= DailyCredits::DAILY_FLOOR %> every day.</p>
    </div>
    <% if @errors.present? %>
      <ul class="errors" role="alert"><% @errors.each do |e| %><li><%= e %></li><% end %></ul>
    <% end %>
    <%= form_with url: registration_path, class: "form" do |f| %>
      <div class="field">
        <%= f.label :display_name, "What should the characters call you?", class: "field__label" %>
        <%= f.text_field :display_name, class: "input", maxlength: 40, autocomplete: "nickname", value: params[:display_name] %>
        <span class="field__hint">Optional. A first name or a nickname.</span>
      </div>
      <div class="field">
        <%= f.label :email_address, "Email", class: "field__label" %>
        <%= f.email_field :email_address, class: "input", required: true, autocomplete: "email", value: params[:email_address] %>
      </div>
      <div class="field">
        <%= f.label :password, "Password", class: "field__label" %>
        <%= f.password_field :password, class: "input", required: true, minlength: 10, autocomplete: "new-password" %>
        <span class="field__hint">At least 10 characters.</span>
      </div>
      <label class="check"><%= check_box_tag :adult, "1", false, required: true %><span>I'm 18 or older.</span></label>
      <label class="check"><%= check_box_tag :terms, "1", false, required: true %><span>I accept the <%= link_to "terms", terms_path, target: "_blank" %> and I've read the <%= link_to "privacy policy", privacy_path, target: "_blank" %>.</span></label>
      <%= f.button "Create my account", class: "btn btn--primary" %>
    <% end %>
    <p class="muted">Already have an account? <%= link_to "Log in", new_session_path %></p>
  </section>
</div>
