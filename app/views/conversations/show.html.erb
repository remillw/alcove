<% content_for :title, @conversation.character.name %>
<% content_for :no_footer, true %>
<% character = @conversation.character %>
<%= turbo_stream_from @conversation %>
<section class="scene" aria-label="Conversation with <%= character.name %>">
  <header class="scene__head">
    <%= render "shared/avatar", character:, size: "sm" %>
    <div class="scene__who">
      <h1><%= character.name %></h1>
      <p><%= character.role %> · AI character</p>
    </div>
    <div class="scene__tools" data-controller="dialog">
      <button type="button" class="btn btn--quiet" data-action="dialog#open" aria-haspopup="dialog">Notebook</button>
      <dialog class="notebook" data-dialog-target="dialog" aria-labelledby="notebook-title">
        <div class="notebook__head">
          <h2 id="notebook-title"><%= character.first_name %>'s notebook</h2>
          <button type="button" class="btn btn--quiet" data-action="dialog#close">Close</button>
        </div>
        <div class="notebook__body">
          <p class="notebook__intro">What <%= character.first_name %> remembers about you. Forget anything you'd rather they didn't keep.</p>
          <% if @conversation.summary.present? %><p class="muted"><em><%= @conversation.summary %></em></p><% end %>
          <ul class="memo" id="memories">
            <% @conversation.memories.order(id: :desc).each do |memory| %>
              <li id="<%= dom_id(memory) %>">
                <span><%= memory.fact %></span>
                <%= button_to "Forget", memory_path(memory), method: :delete, class: "memo__forget", form: { data: { turbo_confirm: "Forget this?" } } %>
              </li>
            <% end %>
          </ul>
          <% if @conversation.memories.none? %><p class="muted">Nothing yet. <%= character.first_name %> starts taking notes after a few exchanges.</p><% end %>
          <%= button_to "Delete this conversation and all memories", conversation_path(@conversation), method: :delete,
                class: "btn btn--quiet btn--danger", form: { data: { turbo_confirm: "Delete the whole conversation with #{character.first_name}? This can't be undone." } } %>
        </div>
      </dialog>
    </div>
  </header>

  <div>
    <p class="notice">You're chatting with an AI character, not a real person. It can be wrong, and it can't give medical, legal or financial advice.</p>
    <div class="log" id="log" role="log" aria-live="polite" aria-relevant="additions" data-controller="scroll">
      <%= render partial: "messages/message", collection: @messages, as: :message %>
    </div>
  </div>

  <%= render "messages/composer", conversation: @conversation, error: nil %>
</section>
