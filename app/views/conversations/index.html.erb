<% content_for :title, t("site.conversations") %>
<div class="stage stage--narrow">
  <h1 class="page-title"><%= t(".title") %></h1>
  <% if @conversations.any? %>
    <ul class="list">
      <% @conversations.each do |conversation| %>
        <li class="list__item">
          <%= render "shared/portrait", character: conversation.character, size: 48 %>
          <div>
            <%= link_to conversation.character.name, conversation_path(conversation) %>
            <p><%= conversation.character.role %><% if conversation.last_message_at %> · <%= t(".ago", time: time_ago_in_words(conversation.last_message_at)) %><% end %></p>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="muted"><%= t(".none_html", link: link_to(t(".meet"), root_path)) %></p>
  <% end %>
</div>
