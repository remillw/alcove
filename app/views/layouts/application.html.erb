<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title).presence ? "#{yield(:title)} · Alcove" : t("site.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="description" content="<%= content_for(:description).presence || t("site.description") %>">
    <meta name="theme-color" content="#1E2423">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "fonts", "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body<% if content_for?(:character) %> data-character="<%= yield(:character) %>"<% end %>>
    <% unless content_for?(:no_bar) %>
    <header class="bar">
      <a href="<%= root_path %>" aria-label="<%= t("site.home") %>"><%= image_tag "logo.svg", alt: "Alcove", class: "bar__logo", width: 120, height: 34 %></a>
      <nav class="bar__nav" aria-label="<%= t("site.nav") %>">
        <% if current_user %>
          <%= turbo_stream_from current_user %>
          <%= link_to t("site.conversations"), conversations_path, class: "bar__link bar__link--wide", "aria-current": (current_page?(conversations_path) ? "page" : nil) %>
          <%= render "shared/credits", user: current_user %>
          <% if current_user.registered? %>
            <%= link_to t("site.account"), account_path, class: "bar__link" %>
          <% else %>
            <%= link_to t("site.sign_up"), new_registration_path, class: "bar__link" %>
          <% end %>
        <% else %>
          <%= link_to t("site.log_in"), new_session_path, class: "bar__link" %>
        <% end %>
      </nav>
    </header>
    <% end %>
    <% if content_for?(:no_bar) && current_user %><%= turbo_stream_from current_user %><% end %>

    <main id="main">
      <% if notice %><p class="flash" role="status"><%= notice %></p><% end %>
      <% if alert %><p class="flash flash--alert" role="alert"><%= alert %></p><% end %>
      <%= yield %>
    </main>

    <% unless content_for?(:no_footer) %>
      <footer class="foot">
        <span>Alcove</span>
        <%= link_to t("site.terms"), terms_path %>
        <%= link_to t("site.privacy"), privacy_path %>
        <%= link_to t("site.legal"), legal_path %>
        <%= link_to t("site.switch_to"), url_for(locale: (I18n.locale == :fr ? "en" : "fr")), hreflang: (I18n.locale == :fr ? "en" : "fr"), lang: (I18n.locale == :fr ? "en" : "fr"), class: "foot__lang" %>
        <p class="foot__note"><%= t("site.footer_note") %></p>
      </footer>
    <% end %>
  </body>
</html>
