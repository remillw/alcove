<div class="stage">
  <section class="hero">
    <p class="eyebrow">Original characters · Free to try</p>
    <h1 class="hero__title">Characters who <em>remember</em> you.</h1>
    <p class="hero__lead">A librarian who knows your taste, a cook who works with what's left in your fridge, a detective with a case for you. Pick someone and say hello. No account needed for the first messages.</p>
  </section>

  <ul class="cast" role="list">
    <% @characters.each do |character| %>
      <li class="card">
        <%= render "shared/avatar", character: %>
        <div>
          <h2 class="card__name"><%= link_to character.name, character_path(character) %></h2>
          <p class="card__role"><%= character.role %></p>
        </div>
        <p class="card__tag">“<%= character.tagline %>”</p>
        <div class="card__foot">
          <ul class="traits"><% character.traits.each do |trait| %><li><%= trait %></li><% end %></ul>
          <% if @conversations[character.id] %><span class="card__ongoing">Ongoing</span><% end %>
        </div>
      </li>
    <% end %>
  </ul>

  <section class="how" aria-label="How Alcove works">
    <div><h2>They remember</h2><p>Each character keeps a small notebook about you. You can read it, and you can make them forget anything.</p></div>
    <div><h2>They stay themselves</h2><p>Written personalities, voices and limits. No content for adults, no guilt trips when you leave.</p></div>
    <div><h2>Clear pricing</h2><p>One credit per reply. Your first replies are free, and members get credits topped up every day.</p></div>
  </section>
</div>
