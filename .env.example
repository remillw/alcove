SECRET_KEY_BASE=          # bin/rails secret
ALCOVE_DATABASE_PASSWORD= # long random string
ANTHROPIC_API_KEY=        # server-side only
ANTHROPIC_WORKSPACE_ID=   # only if the key isn't scoped to a workspace (wrkspc_...)
LLM_MODEL=claude-opus-5-5 # or claude-haiku-5-5 for a much lower cost per reply
DAILY_BUDGET_USD=15       # circuit breaker on the day's real API spend
APP_HOST=alcove.victoire-digital.fr
PAYMENTS_PROVIDER=sandbox # sandbox (demo, no money) or stripe
STRIPE_SECRET_KEY=        # stripe only: sk_live_...
STRIPE_WEBHOOK_SECRET=    # stripe only: whsec_... of the endpoint https://<APP_HOST>/webhooks/stripe
SMTP_ADDRESS=             # outgoing mail server; empty = emails are only written to the log
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM="Alcove <hello@victoire-digital.fr>"
